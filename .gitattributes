# Keep development files out of the zip GitHub builds for releases
# and out of `git archive`, which is how the WordPress.org package is built.
/.github           export-ignore
/.wordpress-org    export-ignore
/bin               export-ignore
/docs              export-ignore
/tests             export-ignore
/README.md         export-ignore
/README.es.md      export-ignore
/CONTRIBUTING.md   export-ignore
/composer.json     export-ignore
/composer.lock     export-ignore
/phpcs.xml.dist    export-ignore
/phpunit.xml.dist  export-ignore
/.gitattributes    export-ignore
/.gitignore        export-ignore

# Translations reach WordPress.org sites through translate.wordpress.org, so the
# package ships only the .pot template. The Spanish files stay in the repository
# as the source to import there.
/languages/*.po        export-ignore
/languages/*.mo        export-ignore
/languages/*.l10n.php  export-ignore
